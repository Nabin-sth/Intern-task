# Copy this file to .env and adjust values for your machine.

PORT=3000
NODE_ENV=development

# Replica set is required for MongoDB transactions (register + later wallet ops).
# Atlas example: mongodb+srv://USER:PASS@cluster.mongodb.net/mini-sms-gateway
# Local replica set example:
MONGODB_URI=mongodb://127.0.0.1:27017/mini-sms-gateway?replicaSet=rs0

# Required. Use a long random string. Never commit the real value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# Integer credits granted to each newly registered user.
DEFAULT_WALLET_CREDITS=100

# Mock SMS providers. INITIAL_BALANCE applies only the first time the route is inserted.
ROUTE_A_PRIORITY=1
ROUTE_A_FAILURE_RATE=0.3
ROUTE_A_INITIAL_BALANCE=10000
ROUTE_B_PRIORITY=2
ROUTE_B_FAILURE_RATE=0.1
ROUTE_B_INITIAL_BALANCE=10000
ROUTE_C_PRIORITY=3
ROUTE_C_FAILURE_RATE=0.05
ROUTE_C_INITIAL_BALANCE=10000

# Refund pending credit holds older than this many milliseconds (startup reconcile).
PENDING_RECONCILE_MS=600000

# Integer credits charged per SMS part.
SMS_COST_PER_PART=1

# Provider balance that scores 100% on the health formula's balance term.
HEALTHY_PROVIDER_BALANCE=10000
